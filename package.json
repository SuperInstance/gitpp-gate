{
  "name": "gitpp-gate",
  "version": "0.1.0",
  "description": "Confidence-gated nudging for the git.pp fold. Ask before you nudge; fail closed; log the decision as a record.",
  "type": "module",
  "main": "src/gate.mjs",
  "scripts": {
    "test": "node --test test/effects-gate.test.mjs",
    "test:live": "node test/gate.test.mjs",
    "test:all": "node --test test/effects-gate.test.mjs && node test/gate.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "git.pp",
    "fold",
    "nudge",
    "confidence",
    "gate",
    "fail-closed",
    "provenance"
  ],
  "files": [
    "src",
    "README.md",
    "JEV-CAPABILITY-MAP.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/gate.mjs",
    "./jev": "./src/jev.mjs",
    "./triggers": "./src/triggers.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperInstance/gp2.git"
  },
  "homepage": "https://github.com/SuperInstance/gp2#readme",
  "bugs": {
    "url": "https://github.com/SuperInstance/gp2/issues"
  },
  "author": "SuperInstance"
}
